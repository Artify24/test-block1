# ==============================================================================
# Aegis Security Gateway - Environment Configuration
# ==============================================================================

# Required: Groq API Key for LLM Inference
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Target LLM Model (Default: openai/gpt-oss-120b)
# Compatible Groq options:
#   - openai/gpt-oss-120b
#   - qwen/qwen3.6-27b
#   - llama-3.3-70b-versatile
AEGIS_MODEL="openai/gpt-oss-120b"

# Local-only Operation (0 = Local only, disables cloud telemetry)
AEGIS_ALLOW_CLOUD=0
